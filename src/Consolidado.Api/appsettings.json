{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/consolidado-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "ElasticsearchUrl": ""
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=cashflow_consolidado;Username=cashflow;Password=cashflow"
  },
  "Auth": {
    "Issuer": "cashflow-local",
    "Audience": "cashflow-api",
    "SigningKey": "dev-only-signing-key-change-me-32-chars-min"
  },
  "Kafka": {
    "BootstrapServers": "",
    "Topic": "cashflow.lancamentos.v1",
    "GroupId": "consolidado"
  },
  "TimeZone": {
    "Business": "America/Sao_Paulo"
  },
  "AllowedHosts": "*"
}
