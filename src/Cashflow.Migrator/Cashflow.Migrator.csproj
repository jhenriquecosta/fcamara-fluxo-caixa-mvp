    <ProjectReference Include="..\Cashflow.Modules.Consolidado\Cashflow.Modules.Consolidado.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
