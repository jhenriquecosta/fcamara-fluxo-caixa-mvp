@page "/lancamentos"
@attribute [Authorize(Policy = Policies.PodeConsultar)]
@inherits PaginaBase
@using Cashflow.Blazor.Modules.Core

<PageTitle>Lançamentos · Fluxo de Caixa</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Lançamentos</p>
        <h1>@Formatacao.Dia(Dia)</h1>
    </div>
    <div class="d-flex gap-2 align-items-end flex-wrap">
        <div>
            <label for="dia" class="form-label small mb-1">Dia</label>
            <input id="dia" type="date" class="form-control" value="@Dia.ToString("yyyy-MM-dd")" @onchange="TrocarDiaAsync" />
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@Ocupado" @onclick="CarregarAsync">Atualizar</button>
        <AuthorizeView Policy="@Policies.PodeLancar">
            <a class="btn btn-primary" href="lancamentos/novo">+ Novo lançamento</a>
        </AuthorizeView>
    </div>
</div>

<Alerta Mensagem="@Sucesso" Tipo="success" AoFechar="() => Sucesso = null" />
<Alerta Mensagem="@Erro" />

@if (Lancamentos is null)
{
    @if (Erro is null)
    {
        <p class="text-muted">Carregando…</p>
    }
}
else if (Lancamentos.Count == 0)
{
    <div class="vazio">
        <p>Nenhum lançamento em @Formatacao.Dia(Dia).</p>
    </div>
}
else
{
    <div class="resumo-dia">
        <span>@Lancamentos.Count lançamento(s)</span>
        <span>Movimento do dia: <strong class="@(Movimento < 0 ? "negativo" : "positivo")">@Formatacao.Moeda(Movimento)</strong></span>
    </div>
    <div class="table-responsive card-tabela">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Hora</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Descrição</th>
                    <th scope="col" class="text-end">Valor</th>
                    <th scope="col">Situação</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lancamento in Lancamentos)
                {
                    <tr @key="lancamento.Id" class="@(lancamento.Estornado ? "estornado" : "")">
                        <td class="text-muted">@Formatacao.Hora(lancamento.CriadoEm)</td>
                        <td><span class="badge tipo-@lancamento.Tipo">@Formatacao.Tipo(lancamento.Tipo)</span></td>
                        <td>@(lancamento.EhEstorno ? "Estorno" : lancamento.Descricao ?? "—")</td>
                        <td class="text-end valor">@Formatacao.Moeda(lancamento.Efeito)</td>
                        <td>
                            @if (lancamento.EhEstorno)
                            {
                                <span class="situacao">estorno de @lancamento.EstornoDe.ToString()![..8]</span>
                            }
                            else if (lancamento.Estornado)
                            {
                                <span class="situacao">estornado</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (lancamento.PodeEstornar)
                            {
                                <AuthorizeView Policy="@Policies.PodeLancar" Context="auth">
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => PedirEstorno(lancamento)">Estornar</button>
                                </AuthorizeView>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog @ref="EstornoDialog" Titulo="Estornar lançamento" SimTexto="Estornar" CorConfirmar="danger" AoConfirmar="ConfirmarEstornoAsync">
    <Mensagem>
        @if (Estornando is not null)
        {
            <p class="mb-2">Será criado um lançamento de <strong>@Formatacao.Tipo(Estornando.Tipo == "credito" ? "debito" : "credito")</strong>
               de <strong>@Formatacao.Moeda(Estornando.Valor)</strong> que anula este. O original permanece no histórico.</p>
            <p class="mb-0 text-muted small">@(Estornando.Descricao ?? "sem descrição") · @Formatacao.Hora(Estornando.CriadoEm)</p>
        }
    </Mensagem>
</ConfirmDialog>
