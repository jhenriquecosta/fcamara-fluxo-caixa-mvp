<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- O host das telas, como o ClassifiedAds.BlazorServerSide da referência (ADR-0010). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cashflow.BlazorServerSide</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cashflow.Blazor.Modules\Cashflow.Blazor.Modules.csproj" />
    <ProjectReference Include="..\Cashflow.Infrastructure\Cashflow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cashflow.BlazorServerSide.IntegrationTests" />
  </ItemGroup>

</Project>
