{
  "ServiceName": "web",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ResourceServer": {
    "Lancamentos": "http://localhost:8080",
    "Consolidado": "http://localhost:8081"
  },
  "Auth": {
    "Issuer": "cashflow-local",
    "Audience": "cashflow-api",
    "AccessTokenMinutes": 5
  },
  "Infraestrutura": {
    "Enabled": false,
    "PrometheusUrl": "http://localhost:9090",
    "ElasticsearchUrl": "http://localhost:9200",
    "Servicos": [
      {
        "Nome": "lancamentos-api",
        "Papel": "registra lançamentos e estornos",
        "HealthUrl": "http://localhost:8080/health"
      },
      {
        "Nome": "consolidado-api",
        "Papel": "consulta o saldo diário",
        "HealthUrl": "http://localhost:8081/health"
      },
      {
        "Nome": "background-server",
        "Papel": "publica o outbox e projeta o consolidado",
        "HealthUrl": "http://localhost:8082/health"
      },
      {
        "Nome": "prometheus",
        "Papel": "coleta as métricas",
        "HealthUrl": "http://localhost:9090/-/healthy"
      },
      {
        "Nome": "elasticsearch",
        "Papel": "guarda os logs",
        "HealthUrl": "http://localhost:9200/_cluster/health"
      },
      {
        "Nome": "kibana",
        "Papel": "explora os logs",
        "HealthUrl": "http://localhost:5601/api/status"
      },
      {
        "Nome": "grafana",
        "Papel": "dashboards dos sinais",
        "HealthUrl": "http://localhost:3000/api/health"
      }
    ],
    "Atalhos": [
      {
        "Nome": "Grafana",
        "Descricao": "Dashboard Golden Signals: tráfego, erros, latência, outbox, lag e DLT (admin/admin)",
        "Url": "http://localhost:3000/d/cashflow-golden-signals"
      },
      {
        "Nome": "Kibana",
        "Descricao": "Data view cashflow-logs-*: os logs JSON de todos os serviços",
        "Url": "http://localhost:5601/app/discover"
      },
      {
        "Nome": "Prometheus",
        "Descricao": "Consultas PromQL e o estado das regras de alerta",
        "Url": "http://localhost:9090/alerts"
      }
    ]
  }
}
