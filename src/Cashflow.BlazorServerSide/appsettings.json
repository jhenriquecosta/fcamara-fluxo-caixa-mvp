{
  "ServiceName": "web",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ResourceServer": {
    "Lancamentos": "http://localhost:8080",
    "Consolidado": "http://localhost:8081"
  },
  "Auth": {
    "Issuer": "cashflow-local",
    "Audience": "cashflow-api",
    "AccessTokenMinutes": 5
  }
}
