{
  "ServiceName": "background-server",
  "Serilog": {
    "ElasticsearchUrl": ""
  },
  "MessageBroker": {
    "Provider": "Kafka",
    "Kafka": {
      "BootstrapServers": "localhost:9092"
    }
  },
  "Modules": {
    "Lancamentos": {
      "Enabled": true,
      "ConnectionStrings": {
        "Default": "Host=localhost;Port=5432;Database=cashflow;Username=lancamentos;Password=lancamentos"
      }
    },
    "Consolidado": {
      "Enabled": true,
      "ConnectionStrings": {
        "Default": "Host=localhost;Port=5432;Database=cashflow_consolidado;Username=consolidado;Password=consolidado"
      }
    }
  },
  "AllowedHosts": "*"
}
