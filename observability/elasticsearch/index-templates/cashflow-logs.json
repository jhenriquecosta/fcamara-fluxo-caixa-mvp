{
  "index_patterns": ["cashflow-logs-*"],
  "_meta": {
    "descricao": "O documento como o Serilog.Sinks.Elasticsearch grava: nível e mensagem na raiz, as propriedades do evento em fields.*. Os nomes dos campos em fields seguem logging.md."
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "cashflow-logs-7d"
    },
    "mappings": {
      "dynamic_templates": [
        {
          "fields_texto_como_keyword": {
            "path_match": "fields.*",
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp":      { "type": "date" },
        "level":           { "type": "keyword" },
        "message":         { "type": "text" },
        "messageTemplate": { "type": "keyword", "ignore_above": 1024 },
        "exceptions":      { "type": "object", "enabled": false },
        "fields": {
          "properties": {
            "service":          { "type": "keyword" },
            "env":              { "type": "keyword" },
            "SourceContext":    { "type": "keyword" },
            "RequestPath":      { "type": "keyword" },
            "RequestMethod":    { "type": "keyword" },
            "StatusCode":       { "type": "integer" },
            "Elapsed":          { "type": "double" },
            "trace_id":         { "type": "keyword" },
            "correlation_id":   { "type": "keyword" },
            "request_id":       { "type": "keyword" },
            "ComercianteHash":  { "type": "keyword" },
            "ChaveHash":        { "type": "keyword" }
          }
        }
      }
    }
  }
}
